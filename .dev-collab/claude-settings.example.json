      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git config:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(curl:*)",
      "Bash(iwr:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(winget:*)",
